{
  "id": "tripbrief",
  "title": "Trip Brief",
  "description": "Build a private itinerary with current Canadian travel advisories and export a dated travel brief.",
  "category": "places",
  "tags": [
    "travel",
    "Canada",
    "advisories",
    "itinerary",
    "international",
    "offline"
  ],
  "icon": "map",
  "url": "/tripbrief/",
  "source": "https://github.com/jsdyer/tripbrief",
  "hosting": "project",
  "access": "browser",
  "data_info": {
    "mode": "mixed",
    "detail": "Global Affairs Canada advisory summaries are checked hourly. Your itinerary, notes and saved comparison stay on your device.",
    "cadence": "Hourly",
    "probes": [
      {
        "url": "https://coolcode.ca/tripbrief/data/status.json",
        "path": [
          "checked_at"
        ],
        "precision": "minute",
        "label": "Official advisory index checked",
        "count_at": {
          "path": [
            "count"
          ],
          "unit": "destinations"
        }
      }
    ]
  }
}
